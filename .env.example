# Server only: FastAPI base URL. Never exposed to the browser.
API_BASE_URL=http://127.0.0.1:8000/api/v1
# Public: canonical site URL (metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public: base URL of the backend media files (images).
NEXT_PUBLIC_MEDIA_BASE_URL=http://127.0.0.1:8000/media
# Server only: true ONLY behind our own Nginx (it sets X-Real-IP / X-Forwarded-For from the
# socket address). false: the visitor IP sent to the backend is always 127.0.0.1.
WEB_TRUST_PROXY_HEADERS=false
# Public: Google Identity Services web client id (the same id goes into the backend's
# GOOGLE_CLIENT_IDS). Empty: a dev-only fake Google button in development, none in production.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Public, optional: store contact for "forgot password" (no self-service reset).
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Public, optional: tile layer of the address map. Empty: OpenStreetMap's standard tiles
# (https://tile.openstreetmap.org/{z}/{x}/{y}.png, with its credit). A custom provider needs
# {z}, {x} and {y}; set the matching attribution HTML too (it stays visible on the map).
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
